# Dependencies
node_modules/

# Build output (scoped, so a source folder named build or dist is not hidden)
/apps/*/dist/
/apps/*/build/
/packages/*/dist/
/packages/*/build/
**/android/build/
**/android/app/build/
*.tsbuildinfo

# Expo / React Native
.expo/
web-build/
*.apk
*.aab
*.jks
*.keystore
!debug.keystore

# Android / Gradle
.gradle/
local.properties
.cxx/
.externalNativeBuild/

# Test and E2E output
coverage/
e2e/.output/
*.log

# Environment and secrets (only .env.example is committed)
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/settings.local.json
