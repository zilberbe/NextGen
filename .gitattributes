# Normalize all text files to LF in the repo and in the working tree,
# since the repo is edited on Windows.
* text=auto eol=lf

# Windows scripts (for example the Gradle wrapper) need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.keystore binary
*.jks binary
*.apk binary
*.aab binary
